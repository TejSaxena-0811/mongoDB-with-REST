<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>edit page</title>
</head>
<body>
    <h1>edit your message</h1>
    <h4>from: <%= chat.from %></h4>
    <h4>to: <%= chat.to %></h4>
    <form method="post" action="/chats/<%= chat._id %>?_method=PATCH">
        <textarea name="newMsg" id="newMsg" cols="35" rows="10"><%= chat.msg %></textarea>
        <br><br>
        <button>submit</button>
    </form>
</body>
</html>