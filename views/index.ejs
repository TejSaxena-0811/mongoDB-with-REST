<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Chats</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>All Chats</h1>
    <% for(let chat of chats){ %>
        <ul>
            <li>from: <i><%= chat.from %></i></li>
            <li>to: <i><%= chat.to %></i></li>
            <li class="msg">msg: <%= chat.msg %></li>
            <li>Time: <%= chat.created_at.toString().split(" ")[4] %></li>
            <li>Date: <%= chat.created_at.toString().split(" ").slice(1 , 4).join(" ") %> </li>
            <li>Day: <%= chat.created_at.toString().split(" ")[0] %> </li>
            <a href="http://localhost:3000/chats/<%= chat._id %>/edit"><button>edit</button></a>
            <br><br>
            <form method="post" action="http://localhost:3000/chats/<%= chat._id %>?_method=DELETE">
                <button>delete</button>
            </form>
        </ul>
    <% } %>
    <br><br><br>
    <a href="http://localhost:3000/chats/new"><button>New Chat</button></a>
</body>
</html>