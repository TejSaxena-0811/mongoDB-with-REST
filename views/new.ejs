<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Chat</title>
</head>
<body>
    <h1>Send New Chat</h1>
    <form method="post" action="http://localhost:3000/chats">
        <input type="text" name="from" id="from" placeholder="from">
        <br><br>
        <input type="text" name="to" id="to" placeholder="to">
        <br><br>
        <textarea name="msg" id="msg" placeholder="your message" cols="35" rows="10"></textarea>
        <br><br>
        <button>submit</button>
    </form>
</body>
</html>